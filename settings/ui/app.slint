// 旁译设置窗口。控件用 Fluent；候选预览用旁译自己的色，不把整窗染成强调色。
// 默认字体用微软雅黑 UI，版本号用 Segoe UI Variable。中文不依赖软件渲染器的西文回落。
import { AboutSlint, Button, Palette, Switch } from "std-widgets.slint";

export { Palette }

component LogoMark inherits Rectangle {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: #2FB8CC;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    Text {
        text: "中Я";
        font-family: "Microsoft YaHei UI";
        font-size: 12px;
        color: #FFFFFF;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}

component Mascots inherits Rectangle {
    in property <bool> dark;
    in property <length> side: 32px;
    // 颜色与 ime/src/settings.rs 里熊猫、套娃的浅色 / 深色相同。
    property <color> ink: dark ? #D9D9DE : #3A3A3E;
    property <color> paper: #FFFFFF;
    property <color> blush: dark ? #B56A7C : #F5A8B8;
    property <color> red: #D94F4F;
    property <color> red-dark: #A93A3A;
    property <color> skin: #FFE3C9;
    property <color> gold: #FFD34D;

    width: side * 2.3;
    height: side;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    Rectangle {
        width: root.side;
        height: root.side;
        x: 0;
        y: 0;

        Rectangle {
            x: parent.width * 0.06;
            y: parent.height * 0.04;
            width: parent.width * 0.28;
            height: parent.height * 0.28;
            border-radius: self.width / 2;
            background: root.ink;
        }

        Rectangle {
            x: parent.width * 0.66;
            y: parent.height * 0.04;
            width: parent.width * 0.28;
            height: parent.height * 0.28;
            border-radius: self.width / 2;
            background: root.ink;
        }

        Rectangle {
            x: parent.width * 0.10;
            y: parent.height * 0.20;
            width: parent.width * 0.80;
            height: parent.height * 0.72;
            border-radius: self.width / 2;
            background: root.ink;
        }

        Rectangle {
            x: parent.width * 0.16;
            y: parent.height * 0.26;
            width: parent.width * 0.68;
            height: parent.height * 0.60;
            border-radius: self.width / 2;
            background: root.paper;
        }

        Rectangle {
            x: parent.width * 0.28;
            y: parent.height * 0.40;
            width: parent.width * 0.14;
            height: parent.height * 0.18;
            border-radius: self.width / 2;
            background: root.ink;
        }

        Rectangle {
            x: parent.width * 0.58;
            y: parent.height * 0.40;
            width: parent.width * 0.14;
            height: parent.height * 0.18;
            border-radius: self.width / 2;
            background: root.ink;
        }

        Rectangle {
            x: parent.width * 0.31;
            y: parent.height * 0.40;
            width: parent.width * 0.06;
            height: parent.height * 0.06;
            border-radius: self.width / 2;
            background: root.paper;
        }

        Rectangle {
            x: parent.width * 0.61;
            y: parent.height * 0.40;
            width: parent.width * 0.06;
            height: parent.height * 0.06;
            border-radius: self.width / 2;
            background: root.paper;
        }

        Rectangle {
            x: parent.width * 0.18;
            y: parent.height * 0.62;
            width: parent.width * 0.12;
            height: parent.height * 0.10;
            border-radius: self.width / 2;
            background: root.blush;
        }

        Rectangle {
            x: parent.width * 0.70;
            y: parent.height * 0.62;
            width: parent.width * 0.12;
            height: parent.height * 0.10;
            border-radius: self.width / 2;
            background: root.blush;
        }

        Rectangle {
            x: parent.width * 0.44;
            y: parent.height * 0.58;
            width: parent.width * 0.12;
            height: parent.height * 0.08;
            border-radius: self.width / 2;
            background: root.ink;
        }
    }

    Rectangle {
        x: root.side * 1.2;
        y: 0;
        width: root.side;
        height: root.side;

        Rectangle {
            x: parent.width * 0.16;
            y: parent.height * 0.46;
            width: parent.width * 0.68;
            height: parent.height * 0.50;
            border-radius: parent.width * 0.18;
            background: root.red-dark;
        }

        Rectangle {
            x: parent.width * 0.22;
            y: parent.height * 0.50;
            width: parent.width * 0.56;
            height: parent.height * 0.42;
            border-radius: parent.width * 0.16;
            background: root.red;
        }

        Rectangle {
            x: parent.width * 0.24;
            y: parent.height * 0.06;
            width: parent.width * 0.52;
            height: parent.height * 0.42;
            border-radius: self.width / 2;
            background: root.red-dark;
        }

        Rectangle {
            x: parent.width * 0.30;
            y: parent.height * 0.12;
            width: parent.width * 0.40;
            height: parent.height * 0.34;
            border-radius: self.width / 2;
            background: root.skin;
        }

        Rectangle {
            x: parent.width * 0.32;
            y: parent.height * 0.38;
            width: parent.width * 0.36;
            height: parent.height * 0.10;
            border-radius: 2px;
            background: root.gold;
        }

        Rectangle {
            x: parent.width * 0.38;
            y: parent.height * 0.22;
            width: parent.width * 0.06;
            height: parent.height * 0.06;
            border-radius: self.width / 2;
            background: root.ink;
        }

        Rectangle {
            x: parent.width * 0.56;
            y: parent.height * 0.22;
            width: parent.width * 0.06;
            height: parent.height * 0.06;
            border-radius: self.width / 2;
            background: root.ink;
        }

        Rectangle {
            x: parent.width * 0.36;
            y: parent.height * 0.60;
            width: parent.width * 0.28;
            height: parent.height * 0.26;
            border-radius: 4px;
            background: root.paper;
        }
    }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 40px;
    border-radius: 8px;
    background: transparent;

    hit := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    states [
        active when root.active: {
            background: Palette.selection-background;
        }
        hover when !root.active && hit.has-hover: {
            background: Palette.control-background;
        }
    ]

    Text {
        x: 12px;
        text: root.label;
        font-family: "Microsoft YaHei UI";
        font-size: 14px;
        vertical-alignment: center;
        height: 100%;
        color: root.active ? Palette.selection-foreground : Palette.foreground;
    }
}

component Card inherits Rectangle {
    in property <string> title;
    vertical-stretch: 0;
    background: Palette.control-background;
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;

    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        alignment: start;

        Text {
            text: root.title;
            font-family: "Microsoft YaHei UI";
            font-size: 13px;
            font-weight: 600;
            color: Palette.foreground;
        }

        @children
    }
}

component Hint inherits Text {
    font-family: "Microsoft YaHei UI";
    font-size: 12px;
    wrap: word-wrap;
    color: Palette.foreground.with-alpha(0.72);
}

component Row inherits Rectangle {
    in property <string> label;
    vertical-stretch: 0;
    min-height: 32px;

    HorizontalLayout {
        spacing: 16px;
        alignment: space-between;

        Text {
            text: root.label;
            font-family: "Microsoft YaHei UI";
            font-size: 14px;
            color: Palette.foreground;
            vertical-alignment: center;
        }

        @children
    }
}

component Segmented inherits Rectangle {
    in property <[string]> labels;
    in property <int> current;
    callback selected(int);
    vertical-stretch: 0;
    horizontal-stretch: 0;
    min-width: 240px;
    height: 32px;
    border-radius: 8px;
    background: Palette.background;
    border-width: 1px;
    border-color: Palette.border;

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;

        for label[index] in root.labels: Rectangle {
            horizontal-stretch: 1;
            border-radius: 6px;
            background: root.current == index ? Palette.accent-background : transparent;

            TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                clicked => {
                    root.selected(index);
                }
            }

            Text {
                text: label;
                font-family: "Microsoft YaHei UI";
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
                color: root.current == index ? Palette.accent-foreground : Palette.foreground;
            }
        }
    }
}

component Dot inherits Rectangle {
    in property <color> dot;
    in property <string> name;
    in property <bool> selected;
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background: dot;
    border-width: selected ? 3px : 1px;
    border-color: selected ? Palette.foreground : Palette.border;
    accessible-role: button;
    accessible-label: name;

    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component CandPreview inherits Rectangle {
    in property <bool> horizontal;
    in property <color> card;
    in property <color> frame;
    in property <color> text;
    in property <color> faint;
    in property <color> fill;
    in property <color> bar-text;
    in property <length> text-px;
    in property <length> anno-px;
    in property <length> index-px;
    vertical-stretch: 0;
    background: card;
    border-color: frame;
    border-width: 1px;
    border-radius: 10px;

    if !root.horizontal: VerticalLayout {
        padding: 8px;
        spacing: 8px;
        alignment: start;

        Rectangle {
            vertical-stretch: 0;
            background: root.fill;
            border-radius: 8px;

            HorizontalLayout {
                padding: 4px;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                alignment: start;

                Text {
                    text: "1.";
                    font-size: root.index-px;
                    color: root.bar-text;
                    font-family: "Microsoft YaHei UI";
                    vertical-alignment: center;
                }

                Text {
                    text: "电子邮箱";
                    font-size: root.text-px;
                    color: root.bar-text;
                    font-family: "Microsoft YaHei UI";
                    vertical-alignment: center;
                }

                Text {
                    text: "электронная почта";
                    font-size: root.anno-px;
                    color: root.bar-text;
                    font-family: "Microsoft YaHei UI";
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            vertical-stretch: 0;

            HorizontalLayout {
                padding: 4px;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                alignment: start;

                Text {
                    text: "2.";
                    font-size: root.index-px;
                    color: root.faint;
                    font-family: "Microsoft YaHei UI";
                    vertical-alignment: center;
                }

                Text {
                    text: "微信号";
                    font-size: root.text-px;
                    color: root.text;
                    font-family: "Microsoft YaHei UI";
                    vertical-alignment: center;
                }

                Text {
                    text: "WeChat ID";
                    font-size: root.anno-px;
                    color: root.faint;
                    font-family: "Microsoft YaHei UI";
                    vertical-alignment: center;
                }
            }
        }
    }

    if root.horizontal: VerticalLayout {
        padding: 8px;
        spacing: 4px;
        alignment: start;

        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            Rectangle {
                vertical-stretch: 0;
                background: root.fill;
                border-radius: 8px;

                HorizontalLayout {
                    padding: 4px;
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 4px;

                    Text {
                        text: "1.";
                        font-size: root.index-px;
                        color: root.bar-text;
                        font-family: "Microsoft YaHei UI";
                        vertical-alignment: center;
                    }

                    Text {
                        text: "电子邮箱";
                        font-size: root.text-px;
                        color: root.bar-text;
                        font-family: "Microsoft YaHei UI";
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                vertical-stretch: 0;

                HorizontalLayout {
                    padding: 4px;
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 4px;

                    Text {
                        text: "2.";
                        font-size: root.index-px;
                        color: root.faint;
                        font-family: "Microsoft YaHei UI";
                        vertical-alignment: center;
                    }

                    Text {
                        text: "微信号";
                        font-size: root.text-px;
                        color: root.text;
                        font-family: "Microsoft YaHei UI";
                        vertical-alignment: center;
                    }
                }
            }
        }

        Text {
            text: "электронная почта";
            font-size: root.anno-px;
            color: root.faint;
            font-family: "Microsoft YaHei UI";
        }
    }
}

export component MainWindow inherits Window {
    title: "旁译 设置  v" + version;
    preferred-width: 820px;
    preferred-height: 560px;
    min-width: 720px;
    min-height: 480px;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 14px;
    background: Palette.background;
    forward-focus: keys;

    in property <string> version: "4.19.0";
    in-out property <int> page: 0;
    in-out property <string> status: "";

    in-out property <int> max-index: 2;
    in-out property <int> scale-index: 1;
    in-out property <bool> cnpunct: true;
    in-out property <bool> english: false;
    in-out property <bool> emoji: false;
    in-out property <int> layout-index: 0;
    in-out property <int> theme-index: 0;
    in-out property <int> accent-index: 0;
    in-out property <int> trmode: 0;
    in-out property <bool> updater-on: true;
    in property <bool> mascot-dark: false;

    in property <color> pv-card: #FFFFFF;
    in property <color> pv-border: #E3E6EA;
    in property <color> pv-text: #1D1D1F;
    in property <color> pv-faint: #6B6B70;
    in property <color> pv-fill: #DDF2F6;
    in property <color> pv-bar-text: #17606C;
    in property <length> pv-text-px: 16px;
    in property <length> pv-anno-px: 12px;
    in property <length> pv-index-px: 11px;
    in property <bool> pv-horizontal: false;
    in property <color> dot0: #2FB8CC;
    in property <color> dot1: #D46A9C;
    in property <color> dot2: #E09640;
    in property <color> dot3: #9A70D8;
    in property <color> dot4: #3EB060;

    in property <string> stat-phrases: "还没有";
    in property <string> stat-dict: "还没有";
    in property <string> stat-gloss: "还没有";
    in property <string> stat-packs: "还没有";
    in property <string> stat-learned: "还没有";

    callback max-selected(int);
    callback scale-selected(int);
    callback cnpunct-toggled(bool);
    callback english-toggled(bool);
    callback emoji-toggled(bool);
    callback layout-selected(int);
    callback theme-selected(int);
    callback accent-selected(int);
    callback trmode-selected(int);
    callback open-phrases();
    callback open-user-dict();
    callback open-user-gloss();
    callback open-packs();
    callback lexicon-shown();
    callback open-account();
    callback check-update();
    callback updater-toggled(bool);
    callback request-close();

    init => {
        keys.focus();
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.request-close();
                return accept;
            }
            reject
        }
    }

    HorizontalLayout {
        spacing: 0;

        Rectangle {
            width: 208px;
            background: Palette.alternate-background;

            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                alignment: start;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    LogoMark { }

                    VerticalLayout {
                        alignment: center;
                        spacing: 0;

                        Text {
                            text: "旁译";
                            font-family: "Microsoft YaHei UI";
                            font-size: 16px;
                            font-weight: 600;
                            color: Palette.foreground;
                        }

                        Text {
                            text: "v" + root.version;
                            font-family: "Segoe UI Variable";
                            font-size: 12px;
                            color: Palette.foreground;
                        }
                    }
                }

                Mascots {
                    dark: root.mascot-dark;
                    side: 32px;
                }

                NavItem {
                    label: "常规";
                    active: root.page == 0;
                    clicked => {
                        root.page = 0;
                    }
                }

                NavItem {
                    label: "外观";
                    active: root.page == 1;
                    clicked => {
                        root.page = 1;
                    }
                }

                NavItem {
                    label: "翻译";
                    active: root.page == 2;
                    clicked => {
                        root.page = 2;
                    }
                }

                NavItem {
                    label: "词库";
                    active: root.page == 3;
                    clicked => {
                        root.page = 3;
                        root.lexicon-shown();
                    }
                }

                NavItem {
                    label: "账号";
                    active: root.page == 4;
                    clicked => {
                        root.page = 4;
                    }
                }

                NavItem {
                    label: "更新";
                    active: root.page == 5;
                    clicked => {
                        root.page = 5;
                    }
                }

                NavItem {
                    label: "关于";
                    active: root.page == 6;
                    clicked => {
                        root.page = 6;
                    }
                }
            }
        }

        Rectangle {
            width: 1px;
            background: Palette.border;
        }

        Flickable {
            horizontal-stretch: 1;
            content-height: inner.preferred-height;

            inner := VerticalLayout {
                padding: 16px;
                spacing: 16px;
                alignment: start;

                if root.page == 0: VerticalLayout {
                    spacing: 16px;
                    alignment: start;

                    Card {
                        title: "候选";

                        Row {
                            label: "候选个数";

                            Segmented {
                                labels: ["5", "7", "9"];
                                current: root.max-index;
                                selected(index) => {
                                    root.max-selected(index);
                                }
                            }
                        }

                        Row {
                            label: "字号";

                            Segmented {
                                labels: ["小", "标准", "大"];
                                current: root.scale-index;
                                selected(index) => {
                                    root.scale-selected(index);
                                }
                            }
                        }
                    }

                    Card {
                        title: "输入";

                        Row {
                            label: "中文标点";

                            Switch {
                                checked <=> root.cnpunct;
                                toggled => {
                                    root.cnpunct-toggled(root.cnpunct);
                                }
                            }
                        }

                        Row {
                            label: "英文模式";

                            Switch {
                                checked <=> root.english;
                                toggled => {
                                    root.english-toggled(root.english);
                                }
                            }
                        }

                        Row {
                            label: "表情模式";

                            Switch {
                                checked <=> root.emoji;
                                toggled => {
                                    root.emoji-toggled(root.emoji);
                                }
                            }
                        }
                    }

                    Hint {
                        text: "中文标点也可以用 Ctrl+. 翻转，英文模式和单击 Shift 是同一个开关。英文模式和表情模式大约半秒内会跟上。候选个数和字号要等输入法下次激活。";
                    }
                }

                if root.page == 1: VerticalLayout {
                    spacing: 16px;
                    alignment: start;

                    Text {
                        text: "候选窗预览";
                        font-family: "Microsoft YaHei UI";
                        font-size: 13px;
                        font-weight: 600;
                        color: Palette.foreground;
                    }

                    CandPreview {
                        horizontal: root.pv-horizontal;
                        card: root.pv-card;
                        frame: root.pv-border;
                        text: root.pv-text;
                        faint: root.pv-faint;
                        fill: root.pv-fill;
                        bar-text: root.pv-bar-text;
                        text-px: root.pv-text-px;
                        anno-px: root.pv-anno-px;
                        index-px: root.pv-index-px;
                    }

                    Card {
                        title: "窗口";

                        Row {
                            label: "排版";

                            Segmented {
                                labels: ["竖排", "横排"];
                                current: root.layout-index;
                                min-width: 160px;
                                selected(index) => {
                                    root.layout-selected(index);
                                }
                            }
                        }

                        Row {
                            label: "主题";

                            Segmented {
                                labels: ["跟随系统", "浅色", "深色"];
                                current: root.theme-index;
                                min-width: 280px;
                                selected(index) => {
                                    root.theme-selected(index);
                                }
                            }
                        }

                        Row {
                            label: "配色";

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;

                                Dot {
                                    dot: root.dot0;
                                    name: "青";
                                    selected: root.accent-index == 0;
                                    clicked => {
                                        root.accent-selected(0);
                                    }
                                }

                                Dot {
                                    dot: root.dot1;
                                    name: "粉";
                                    selected: root.accent-index == 1;
                                    clicked => {
                                        root.accent-selected(1);
                                    }
                                }

                                Dot {
                                    dot: root.dot2;
                                    name: "橙";
                                    selected: root.accent-index == 2;
                                    clicked => {
                                        root.accent-selected(2);
                                    }
                                }

                                Dot {
                                    dot: root.dot3;
                                    name: "紫";
                                    selected: root.accent-index == 3;
                                    clicked => {
                                        root.accent-selected(3);
                                    }
                                }

                                Dot {
                                    dot: root.dot4;
                                    name: "绿";
                                    selected: root.accent-index == 4;
                                    clicked => {
                                        root.accent-selected(4);
                                    }
                                }
                            }
                        }
                    }

                    Hint {
                        text: "预览会马上变。正在打字的程序要等这次输入结束、下次激活旁译，候选窗才会换成新的字号、排版、主题和配色。";
                    }
                }

                if root.page == 2: VerticalLayout {
                    spacing: 16px;
                    alignment: start;

                    Card {
                        title: "模式";

                        Row {
                            label: "翻译模式";

                            Segmented {
                                labels: ["关", "逐字", "整句"];
                                current: root.trmode;
                                selected(index) => {
                                    root.trmode-selected(index);
                                }
                            }
                        }
                    }

                    Hint {
                        text: "Ctrl+, 会在关、逐字、整句之间循环。正在打字的程序要等输入法下次激活。";
                    }
                }

                if root.page == 3: VerticalLayout {
                    spacing: 16px;
                    alignment: start;

                    Card {
                        title: "文件";

                        Row {
                            label: "自定义短语";

                            Button {
                                text: "打开短语文件";
                                horizontal-stretch: 0;
                                clicked => {
                                    root.open-phrases();
                                }
                            }
                        }

                        Row {
                            label: "用户词库";

                            Button {
                                text: "打开用户词库";
                                horizontal-stretch: 0;
                                clicked => {
                                    root.open-user-dict();
                                }
                            }
                        }

                        Row {
                            label: "用户释义";

                            Button {
                                text: "打开用户释义";
                                horizontal-stretch: 0;
                                clicked => {
                                    root.open-user-gloss();
                                }
                            }
                        }

                        Row {
                            label: "表情包";

                            Button {
                                text: "打开表情包文件夹";
                                horizontal-stretch: 0;
                                clicked => {
                                    root.open-packs();
                                }
                            }
                        }
                    }

                    Card {
                        title: "本机文件";

                        Hint {
                            text: "自定义短语  " + root.stat-phrases;
                        }

                        Hint {
                            text: "用户词库  " + root.stat-dict;
                        }

                        Hint {
                            text: "用户释义  " + root.stat-gloss;
                        }

                        Hint {
                            text: "表情包  " + root.stat-packs;
                        }

                        Hint {
                            text: "自学习  " + root.stat-learned;
                        }
                    }

                    Card {
                        title: "内置词库";

                        Hint {
                            text: "条数在输入法里，本程序不内嵌词库。";
                        }
                    }
                }

                if root.page == 4: VerticalLayout {
                    spacing: 16px;
                    alignment: start;

                    Card {
                        title: "登录";

                        Row {
                            label: "旁译账号";

                            Button {
                                text: "打开账号窗口";
                                horizontal-stretch: 0;
                                clicked => {
                                    root.open-account();
                                }
                            }
                        }
                    }

                    Card {
                        title: "说明";

                        Hint {
                            text: "打字、词库和表情包都不需要登录。输入法不上传按键、候选或词库。只有账号窗口在发送验证码、登录或退出时才会联网。没有配置登录服务时，那个窗口会写明登录不可用。打不开也不影响打字。";
                        }
                    }
                }

                if root.page == 5: VerticalLayout {
                    spacing: 16px;
                    alignment: start;

                    Card {
                        title: "检查";

                        Row {
                            label: "检查更新";

                            Button {
                                text: "检查更新";
                                horizontal-stretch: 0;
                                clicked => {
                                    root.check-update();
                                }
                            }
                        }

                        Row {
                            label: "自动检查";

                            Switch {
                                checked <=> root.updater-on;
                                toggled => {
                                    root.updater-toggled(root.updater-on);
                                }
                            }
                        }
                    }

                    Hint {
                        text: "检查和开关都交给已经安装的更新程序，结果由它自己提示。这个窗口不联网。自动检查默认开；配置文件还不存在时也按开显示。";
                    }
                }

                if root.page == 6: VerticalLayout {
                    spacing: 16px;
                    alignment: center;

                    Mascots {
                        dark: root.mascot-dark;
                        side: 72px;
                    }

                    Text {
                        text: "旁译";
                        font-family: "Microsoft YaHei UI";
                        font-size: 28px;
                        font-weight: 600;
                        color: Palette.foreground;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "v" + root.version;
                        font-family: "Segoe UI Variable";
                        font-size: 14px;
                        color: Palette.foreground;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "中文输入，俄语候选。";
                        font-family: "Microsoft YaHei UI";
                        font-size: 14px;
                        color: Palette.foreground;
                        horizontal-alignment: center;
                    }

                    Card {
                        title: "许可";

                        Hint {
                            text: "旁译自己的代码按 MIT 许可发布。词典数据按 CC BY-SA 3.0 / 4.0 随输入法发布，不编进这个设置程序。";
                        }

                        Hint {
                            text: "界面用 Slint 绘制。下面这枚徽章是免版税协议要求的署名，不是广告。";
                        }

                        Rectangle {
                            height: 120px;
                            vertical-stretch: 0;

                            AboutSlint { }
                        }
                    }

                    Card {
                        title: "输入法本体";

                        Hint {
                            text: "输入法本体离线运行，没有广告，也不做遥测。账号窗口和更新程序是另外两个程序。";
                        }
                    }
                }

                Text {
                    text: root.status;
                    font-family: "Microsoft YaHei UI";
                    font-size: 12px;
                    wrap: word-wrap;
                    min-height: 20px;
                    color: Palette.foreground;
                }
            }
        }
    }
}
