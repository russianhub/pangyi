// 旁译设置窗口。控件用 Fluent；候选预览用旁译自己的色，不把整窗染成强调色。
// 默认字体用微软雅黑 UI，版本号用 Segoe UI Variable。中文不依赖软件渲染器的西文回落。
import { AboutSlint, Button, CheckBox, ComboBox, LineEdit, ListView, Palette, TextEdit } from "std-widgets.slint";

export struct LexChoice {
    label: string,
    checked: bool,
}

export { Palette }

component LogoMark inherits Rectangle {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: #2FB8CC;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    Text {
        text: "中Я";
        font-family: "Microsoft YaHei UI";
        font-size: 12px;
        color: #FFFFFF;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}

component Mascots inherits Rectangle {
    in property <bool> dark;
    in property <length> side: 32px;
    // 颜色与 ime/src/settings.rs 里熊猫、套娃的浅色 / 深色相同。
    property <color> ink: dark ? #D9D9DE : #3A3A3E;
    property <color> paper: #FFFFFF;
    property <color> blush: dark ? #B56A7C : #F5A8B8;
    property <color> red: #D94F4F;
    property <color> red-dark: #A93A3A;
    property <color> skin: #FFE3C9;
    property <color> gold: #FFD34D;

    width: side * 2.3;
    height: side;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    Rectangle {
        width: root.side;
        height: root.side;
        x: 0;
        y: 0;

        Rectangle {
            x: parent.width * 0.06;
            y: parent.height * 0.04;
            width: parent.width * 0.28;
            height: parent.height * 0.28;
            border-radius: self.width / 2;
            background: root.ink;
        }

        Rectangle {
            x: parent.width * 0.66;
            y: parent.height * 0.04;
            width: parent.width * 0.28;
            height: parent.height * 0.28;
            border-radius: self.width / 2;
            background: root.ink;
        }

        Rectangle {
            x: parent.width * 0.10;
            y: parent.height * 0.20;
            width: parent.width * 0.80;
            height: parent.height * 0.72;
            border-radius: self.width / 2;
            background: root.ink;
        }

        Rectangle {
            x: parent.width * 0.16;
            y: parent.height * 0.26;
            width: parent.width * 0.68;
            height: parent.height * 0.60;
            border-radius: self.width / 2;
            background: root.paper;
        }

        Rectangle {
            x: parent.width * 0.28;
            y: parent.height * 0.40;
            width: parent.width * 0.14;
            height: parent.height * 0.18;
            border-radius: self.width / 2;
            background: root.ink;
        }

        Rectangle {
            x: parent.width * 0.58;
            y: parent.height * 0.40;
            width: parent.width * 0.14;
            height: parent.height * 0.18;
            border-radius: self.width / 2;
            background: root.ink;
        }

        Rectangle {
            x: parent.width * 0.31;
            y: parent.height * 0.40;
            width: parent.width * 0.06;
            height: parent.height * 0.06;
            border-radius: self.width / 2;
            background: root.paper;
        }

        Rectangle {
            x: parent.width * 0.61;
            y: parent.height * 0.40;
            width: parent.width * 0.06;
            height: parent.height * 0.06;
            border-radius: self.width / 2;
            background: root.paper;
        }

        Rectangle {
            x: parent.width * 0.18;
            y: parent.height * 0.62;
            width: parent.width * 0.12;
            height: parent.height * 0.10;
            border-radius: self.width / 2;
            background: root.blush;
        }

        Rectangle {
            x: parent.width * 0.70;
            y: parent.height * 0.62;
            width: parent.width * 0.12;
            height: parent.height * 0.10;
            border-radius: self.width / 2;
            background: root.blush;
        }

        Rectangle {
            x: parent.width * 0.44;
            y: parent.height * 0.58;
            width: parent.width * 0.12;
            height: parent.height * 0.08;
            border-radius: self.width / 2;
            background: root.ink;
        }
    }

    Rectangle {
        x: root.side * 1.2;
        y: 0;
        width: root.side;
        height: root.side;

        Rectangle {
            x: parent.width * 0.16;
            y: parent.height * 0.46;
            width: parent.width * 0.68;
            height: parent.height * 0.50;
            border-radius: parent.width * 0.18;
            background: root.red-dark;
        }

        Rectangle {
            x: parent.width * 0.22;
            y: parent.height * 0.50;
            width: parent.width * 0.56;
            height: parent.height * 0.42;
            border-radius: parent.width * 0.16;
            background: root.red;
        }

        Rectangle {
            x: parent.width * 0.24;
            y: parent.height * 0.06;
            width: parent.width * 0.52;
            height: parent.height * 0.42;
            border-radius: self.width / 2;
            background: root.red-dark;
        }

        Rectangle {
            x: parent.width * 0.30;
            y: parent.height * 0.12;
            width: parent.width * 0.40;
            height: parent.height * 0.34;
            border-radius: self.width / 2;
            background: root.skin;
        }

        Rectangle {
            x: parent.width * 0.32;
            y: parent.height * 0.38;
            width: parent.width * 0.36;
            height: parent.height * 0.10;
            border-radius: 2px;
            background: root.gold;
        }

        Rectangle {
            x: parent.width * 0.38;
            y: parent.height * 0.22;
            width: parent.width * 0.06;
            height: parent.height * 0.06;
            border-radius: self.width / 2;
            background: root.ink;
        }

        Rectangle {
            x: parent.width * 0.56;
            y: parent.height * 0.22;
            width: parent.width * 0.06;
            height: parent.height * 0.06;
            border-radius: self.width / 2;
            background: root.ink;
        }

        Rectangle {
            x: parent.width * 0.36;
            y: parent.height * 0.60;
            width: parent.width * 0.28;
            height: parent.height * 0.26;
            border-radius: 4px;
            background: root.paper;
        }
    }
}

// 当前配色。由 MainWindow 在配色或深浅变化时同步。控件不再用系统蓝，而是跟着旁译的配色走。
global Theme {
    in-out property <color> accent: #2FB8CC;
    in-out property <color> on-accent: #FFFFFF;
    // 浅色下强调色上放白字，对比度不够，所以只在浅色时压深一点；深色用原色加深色字。
    in-out property <bool> dark: false;
    out property <color> fill: dark ? accent : accent.darker(0.22);
    out property <color> muted: Palette.foreground.with-alpha(0.66);
    out property <color> hairline: Palette.foreground.with-alpha(0.09);
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 40px;
    border-radius: 6px;
    background: transparent;

    hit := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    states [
        active when root.active: {
            background: Palette.foreground.with-alpha(0.08);
        }
        hover when !root.active && hit.has-hover: {
            background: Palette.foreground.with-alpha(0.05);
        }
    ]

    // Win11 导航的选中指示条。
    Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: root.active ? 16px : 0px;
        border-radius: 1.5px;
        background: Theme.fill;
        animate height { duration: 120ms; }
    }

    Text {
        x: 16px;
        text: root.label;
        font-family: "Microsoft YaHei UI";
        font-size: 14px;
        font-weight: root.active ? 600 : 400;
        vertical-alignment: center;
        height: 100%;
        color: Palette.foreground;
    }
}

component PageHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 4px;
    vertical-stretch: 0;

    Text {
        text: root.title;
        font-family: "Microsoft YaHei UI";
        font-size: 24px;
        font-weight: 600;
        color: Palette.foreground;
    }

    Text {
        text: root.subtitle;
        font-family: "Microsoft YaHei UI";
        font-size: 13px;
        wrap: word-wrap;
        color: Theme.muted;
    }
}

// 分组：小标题在卡片外面，卡片里是一行一行的设置。
component Card inherits VerticalLayout {
    in property <string> title;
    spacing: 8px;
    vertical-stretch: 0;

    Text {
        text: root.title;
        font-family: "Microsoft YaHei UI";
        font-size: 13px;
        font-weight: 600;
        color: Theme.muted;
    }

    Rectangle {
        background: Palette.control-background;
        border-radius: 8px;
        border-width: 1px;
        border-color: Palette.foreground.with-alpha(0.14);

        VerticalLayout {
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 0;
            alignment: start;

            @children
        }
    }
}

component Hint inherits Text {
    font-family: "Microsoft YaHei UI";
    font-size: 12px;
    wrap: word-wrap;
    color: Theme.muted;
}

// 一行设置：左边名称加一句说明，右边是控件。
component Row inherits Rectangle {
    in property <string> label;
    in property <string> desc;
    in property <bool> divider: true;
    vertical-stretch: 0;
    min-height: 56px;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 24px;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.label;
                font-family: "Microsoft YaHei UI";
                font-size: 14px;
                color: Palette.foreground;
                wrap: word-wrap;
            }

            if root.desc != "": Text {
                text: root.desc;
                font-family: "Microsoft YaHei UI";
                font-size: 12px;
                color: Theme.muted;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;

            @children
        }
    }

    if root.divider: Rectangle {
        x: 16px;
        y: parent.height - 1px;
        width: parent.width - 32px;
        height: 1px;
        background: Theme.hairline;
    }
}

// 只读的一行：左边名称，右边一个值。
component ValueRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> divider: true;
    vertical-stretch: 0;
    min-height: 40px;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;

        Text {
            text: root.label;
            font-family: "Microsoft YaHei UI";
            font-size: 14px;
            color: Palette.foreground;
            vertical-alignment: center;
        }

        Text {
            text: root.value;
            font-family: "Microsoft YaHei UI";
            font-size: 13px;
            color: Theme.muted;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    if root.divider: Rectangle {
        x: 16px;
        y: parent.height - 1px;
        width: parent.width - 32px;
        height: 1px;
        background: Theme.hairline;
    }
}

// 开关：接口和原来的 Switch 一样（checked 加 toggled），颜色跟配色走。
component Toggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled();
    width: 84px;
    height: 24px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    accessible-role: switch;
    accessible-checked: root.checked;
    accessible-label: root.checked ? "开" : "关";
    accessible-action-default => {
        root.checked = !root.checked;
        root.toggled();
    }

    Text {
        x: 0;
        width: 44px;
        text: root.checked ? "开" : "关";
        font-family: "Microsoft YaHei UI";
        font-size: 13px;
        color: Palette.foreground;
        horizontal-alignment: right;
        vertical-alignment: center;
        height: 100%;
    }

    track := Rectangle {
        x: 52px;
        width: 32px;
        height: 16px;
        y: (parent.height - self.height) / 2;
        border-radius: 8px;
        background: root.checked ? Theme.fill : transparent;
        border-width: 1px;
        border-color: root.checked ? Theme.fill : Palette.foreground.with-alpha(0.6);

        Rectangle {
            width: hit.pressed ? 14px : 10px;
            height: 10px;
            border-radius: 5px;
            y: (parent.height - self.height) / 2 - 1px;
            x: root.checked ? parent.width - self.width - 4px : 3px;
            background: root.checked ? Theme.on-accent : Palette.foreground.with-alpha(0.72);
            animate x { duration: 120ms; easing: ease-out; }
        }
    }

    hit := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

component Segmented inherits Rectangle {
    in property <[string]> labels;
    in property <int> current;
    callback selected(int);
    vertical-stretch: 0;
    horizontal-stretch: 0;
    min-width: 180px;
    height: 32px;
    border-radius: 6px;
    background: Palette.foreground.with-alpha(0.05);
    border-width: 1px;
    border-color: Palette.border;

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;

        for label[index] in root.labels: Rectangle {
            horizontal-stretch: 1;
            border-radius: 4px;
            background: root.current == index ? Theme.fill : transparent;

            TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                clicked => {
                    root.selected(index);
                }
            }

            Text {
                text: label;
                font-family: "Microsoft YaHei UI";
                font-size: 13px;
                font-weight: root.current == index ? 600 : 400;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
                color: root.current == index ? Theme.on-accent : Palette.foreground;
            }
        }
    }
}

component Dot inherits Rectangle {
    in property <color> dot;
    in property <string> name;
    in property <bool> selected;
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background: transparent;
    border-width: selected ? 2px : 0px;
    border-color: Palette.foreground;
    accessible-role: button;
    accessible-label: name;

    Rectangle {
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: root.dot;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component CandPreview inherits Rectangle {
    in property <bool> horizontal;
    in property <color> card;
    in property <color> frame;
    in property <color> text;
    in property <color> faint;
    in property <color> fill;
    in property <color> bar-text;
    in property <length> text-px;
    in property <length> anno-px;
    in property <length> index-px;
    vertical-stretch: 0;
    min-height: horizontal ? 64px : 132px;
    background: card;
    border-color: frame;
    border-width: 1px;
    border-radius: 10px;

    if !root.horizontal: VerticalLayout {
        padding: 8px;
        spacing: 8px;
        alignment: start;

        Rectangle {
            vertical-stretch: 0;
            background: root.fill;
            border-radius: 8px;

            HorizontalLayout {
                padding: 4px;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                alignment: start;

                Text {
                    text: "1.";
                    font-size: root.index-px;
                    color: root.bar-text;
                    font-family: "Microsoft YaHei UI";
                    vertical-alignment: center;
                }

                Text {
                    text: "电子邮箱";
                    font-size: root.text-px;
                    color: root.bar-text;
                    font-family: "Microsoft YaHei UI";
                    vertical-alignment: center;
                }

                Text {
                    text: "электронная почта";
                    font-size: root.anno-px;
                    color: root.bar-text;
                    font-family: "Microsoft YaHei UI";
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            vertical-stretch: 0;

            HorizontalLayout {
                padding: 4px;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                alignment: start;

                Text {
                    text: "2.";
                    font-size: root.index-px;
                    color: root.faint;
                    font-family: "Microsoft YaHei UI";
                    vertical-alignment: center;
                }

                Text {
                    text: "微信号";
                    font-size: root.text-px;
                    color: root.text;
                    font-family: "Microsoft YaHei UI";
                    vertical-alignment: center;
                }

                Text {
                    text: "WeChat ID";
                    font-size: root.anno-px;
                    color: root.faint;
                    font-family: "Microsoft YaHei UI";
                    vertical-alignment: center;
                }
            }
        }
    }

    if root.horizontal: VerticalLayout {
        padding: 8px;
        spacing: 4px;
        alignment: start;

        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            Rectangle {
                vertical-stretch: 0;
                background: root.fill;
                border-radius: 8px;

                HorizontalLayout {
                    padding: 4px;
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 4px;

                    Text {
                        text: "1.";
                        font-size: root.index-px;
                        color: root.bar-text;
                        font-family: "Microsoft YaHei UI";
                        vertical-alignment: center;
                    }

                    Text {
                        text: "电子邮箱";
                        font-size: root.text-px;
                        color: root.bar-text;
                        font-family: "Microsoft YaHei UI";
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                vertical-stretch: 0;

                HorizontalLayout {
                    padding: 4px;
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 4px;

                    Text {
                        text: "2.";
                        font-size: root.index-px;
                        color: root.faint;
                        font-family: "Microsoft YaHei UI";
                        vertical-alignment: center;
                    }

                    Text {
                        text: "微信号";
                        font-size: root.text-px;
                        color: root.text;
                        font-family: "Microsoft YaHei UI";
                        vertical-alignment: center;
                    }
                }
            }
        }

        Text {
            text: "электронная почта";
            font-size: root.anno-px;
            color: root.faint;
            font-family: "Microsoft YaHei UI";
        }
    }
}

export component MainWindow inherits Window {
    title: "旁译 设置  v" + version;
    preferred-width: 900px;
    preferred-height: 640px;
    min-width: 760px;
    min-height: 520px;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 14px;
    background: Palette.background;
    forward-focus: keys;

    in property <string> version: "4.19.0";
    in-out property <int> page: 0;
    in-out property <string> status: "";

    in-out property <int> max-index: 2;
    in-out property <int> scale-index: 1;
    in-out property <bool> cnpunct: true;
    in-out property <bool> english: false;
    in-out property <bool> emoji: false;
    in-out property <int> layout-index: 0;
    in-out property <int> theme-index: 0;
    in-out property <int> accent-index: 0;
    in-out property <int> trmode: 0;
    in-out property <bool> updater-on: true;
    in property <bool> mascot-dark: false;
    in property <color> on-accent: #FFFFFF;

    in property <color> pv-card: #FFFFFF;
    in property <color> pv-border: #E3E6EA;
    in property <color> pv-text: #1D1D1F;
    in property <color> pv-faint: #6B6B70;
    in property <color> pv-fill: #DDF2F6;
    in property <color> pv-bar-text: #17606C;
    in property <length> pv-text-px: 16px;
    in property <length> pv-anno-px: 12px;
    in property <length> pv-index-px: 11px;
    in property <bool> pv-horizontal: false;
    in property <color> dot0: #2FB8CC;
    in property <color> dot1: #D46A9C;
    in property <color> dot2: #E09640;
    in property <color> dot3: #9A70D8;
    in property <color> dot4: #3EB060;

    in property <string> stat-phrases: "还没有";
    in property <string> stat-dict: "还没有";
    in property <string> stat-gloss: "还没有";
    in property <string> stat-packs: "还没有";
    in property <string> stat-learned: "还没有";

    in property <[string]> lex-labels;
    in property <[string]> lex-themes;
    in property <[LexChoice]> lex-choices;
    in-out property <int> lex-theme-index: 0;
    in-out property <string> lex-theme-filter;
    in-out property <string> lex-theme;
    in property <bool> lex-crowded;
    in property <bool> lex-can-undo;
    in property <int> lex-selected-count;
    property <bool> lex-bulk-open;
    callback lex-mark(int, bool);
    callback lex-delete-selected();
    callback lex-undo();
    callback lex-reading-changed();
    in-out property <string> lex-search;
    in-out property <int> lex-kind: 0;
    in-out property <int> lex-index: 0;
    in-out property <string> lex-head;
    in-out property <string> lex-reading;
    in-out property <string> lex-russian;
    in-out property <string> lex-extra;
    in property <bool> lex-editing;
    callback lex-kind-changed();
    callback lex-filter();
    callback lex-select(int);
    callback lex-clear();
    callback lex-save();
    callback lex-delete();
    callback lex-import();
    callback lex-add-pack(int);
    callback lex-catalog();
    callback lex-export();
    callback lex-preview();
    callback lex-confirm-import();
    callback lex-cancel-import();
    in-out property <int> lex-duplicate-policy: 0;
    in property <bool> lex-preview-open;
    in property <bool> lex-can-import;
    in property <string> lex-preview-summary;
    in property <string> lex-issues;
    in property <string> lex-metadata;

    callback max-selected(int);
    callback scale-selected(int);
    callback cnpunct-toggled(bool);
    callback english-toggled(bool);
    callback emoji-toggled(bool);
    callback layout-selected(int);
    callback theme-selected(int);
    callback accent-selected(int);
    callback trmode-selected(int);
    callback open-phrases();
    callback open-user-dict();
    callback open-user-gloss();
    callback open-packs();
    callback lexicon-shown();
    callback open-account();
    callback check-update();
    callback updater-toggled(bool);
    callback request-close();

    // 配色、深浅变化时，把当前强调色同步给所有控件。
    function sync-accent() {
        Theme.accent = root.accent-index == 1 ? root.dot1 : root.accent-index == 2 ? root.dot2 : root.accent-index == 3 ? root.dot3 : root.accent-index == 4 ? root.dot4 : root.dot0;
        Theme.on-accent = root.on-accent;
        Theme.dark = root.mascot-dark;
    }

    init => {
        keys.focus();
        root.sync-accent();
    }

    changed accent-index => {
        root.sync-accent();
    }
    changed mascot-dark => {
        root.sync-accent();
    }
    changed on-accent => {
        root.sync-accent();
    }
    changed dot0 => {
        root.sync-accent();
    }
    changed dot1 => {
        root.sync-accent();
    }
    changed dot2 => {
        root.sync-accent();
    }
    changed dot3 => {
        root.sync-accent();
    }
    changed dot4 => {
        root.sync-accent();
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.request-close();
                return accept;
            }
            reject
        }
    }
    HorizontalLayout {
        spacing: 0;

        // 左侧导航
        Rectangle {
            width: 216px;
            background: Palette.alternate-background;

            VerticalLayout {
                padding: 12px;
                padding-top: 20px;
                spacing: 4px;
                alignment: start;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-bottom: 16px;
                    spacing: 12px;
                    alignment: start;

                    LogoMark { }

                    VerticalLayout {
                        alignment: center;
                        spacing: 0;

                        Text {
                            text: "旁译";
                            font-family: "Microsoft YaHei UI";
                            font-size: 16px;
                            font-weight: 600;
                            color: Palette.foreground;
                        }

                        Text {
                            text: "设置  v" + root.version;
                            font-family: "Segoe UI Variable";
                            font-size: 12px;
                            color: Theme.muted;
                        }
                    }
                }

                NavItem {
                    label: "输入";
                    active: root.page == 0;
                    clicked => {
                        root.page = 0;
                    }
                }

                NavItem {
                    label: "外观";
                    active: root.page == 1;
                    clicked => {
                        root.page = 1;
                    }
                }

                NavItem {
                    label: "翻译";
                    active: root.page == 2;
                    clicked => {
                        root.page = 2;
                    }
                }

                NavItem {
                    label: "词库";
                    active: root.page == 3;
                    clicked => {
                        root.page = 3;
                        root.lexicon-shown();
                    }
                }

                NavItem {
                    label: "账号与更新";
                    active: root.page == 4;
                    clicked => {
                        root.page = 4;
                    }
                }

                NavItem {
                    label: "关于";
                    active: root.page == 5;
                    clicked => {
                        root.page = 5;
                    }
                }
            }
        }

        Rectangle {
            width: 1px;
            background: Palette.border;
        }

        VerticalLayout {
            horizontal-stretch: 1;

            Flickable {
                vertical-stretch: 1;
                content-height: inner.preferred-height;

                inner := VerticalLayout {
                    padding-left: 32px;
                    padding-right: 32px;
                    padding-top: 28px;
                    padding-bottom: 24px;
                    spacing: 20px;
                    alignment: start;

                    if root.page == 0: VerticalLayout {
                        spacing: 20px;
                        alignment: start;

                        PageHeader {
                            title: "输入";
                            subtitle: "候选窗的大小，以及打字时的几个常用开关。";
                        }

                        Card {
                            title: "候选";

                            Row {
                                label: "候选个数";
                                desc: "每页显示几个候选词";

                                Segmented {
                                    labels: ["5", "7", "9"];
                                    current: root.max-index;
                                    selected(index) => {
                                        root.max-selected(index);
                                    }
                                }
                            }

                            Row {
                                label: "字号";
                                desc: "候选窗里文字的大小";
                                divider: false;

                                Segmented {
                                    labels: ["小", "标准", "大"];
                                    current: root.scale-index;
                                    selected(index) => {
                                        root.scale-selected(index);
                                    }
                                }
                            }
                        }

                        Card {
                            title: "输入行为";

                            Row {
                                label: "中文标点";
                                desc: "输入中文时使用中文标点，Ctrl+. 可随时翻转";

                                Toggle {
                                    checked <=> root.cnpunct;
                                    toggled => {
                                        root.cnpunct-toggled(root.cnpunct);
                                    }
                                }
                            }

                            Row {
                                label: "英文模式";
                                desc: "直接输出英文字母，和单击 Shift 是同一个开关";

                                Toggle {
                                    checked <=> root.english;
                                    toggled => {
                                        root.english-toggled(root.english);
                                    }
                                }
                            }

                            Row {
                                label: "表情模式";
                                desc: "候选里加入表情符号和表情包";
                                divider: false;

                                Toggle {
                                    checked <=> root.emoji;
                                    toggled => {
                                        root.emoji-toggled(root.emoji);
                                    }
                                }
                            }
                        }

                        Hint {
                            text: "英文模式和表情模式大约半秒内会跟上。候选个数和字号要等输入法下次激活。";
                        }
                    }

                    if root.page == 1: VerticalLayout {
                        spacing: 20px;
                        alignment: start;

                        PageHeader {
                            title: "外观";
                            subtitle: "候选窗的排版、主题和配色。预览会马上变。";
                        }

                        Card {
                            title: "预览";

                            CandPreview {
                                horizontal: root.pv-horizontal;
                                card: root.pv-card;
                                frame: root.pv-border;
                                text: root.pv-text;
                                faint: root.pv-faint;
                                fill: root.pv-fill;
                                bar-text: root.pv-bar-text;
                                text-px: root.pv-text-px;
                                anno-px: root.pv-anno-px;
                                index-px: root.pv-index-px;
                            }
                        }

                        Card {
                            title: "候选窗";

                            Row {
                                label: "排版";
                                desc: "候选词竖着排或横着排";

                                Segmented {
                                    labels: ["竖排", "横排"];
                                    current: root.layout-index;
                                    min-width: 160px;
                                    selected(index) => {
                                        root.layout-selected(index);
                                    }
                                }
                            }

                            Row {
                                label: "主题";
                                desc: "跟随系统，或固定浅色、深色";

                                Segmented {
                                    labels: ["跟随系统", "浅色", "深色"];
                                    current: root.theme-index;
                                    min-width: 252px;
                                    selected(index) => {
                                        root.theme-selected(index);
                                    }
                                }
                            }

                            Row {
                                label: "配色";
                                desc: "候选窗和本窗口的强调色";
                                divider: false;

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: end;

                                    Dot {
                                        dot: root.dot0;
                                        name: "青";
                                        selected: root.accent-index == 0;
                                        clicked => {
                                            root.accent-selected(0);
                                        }
                                    }

                                    Dot {
                                        dot: root.dot1;
                                        name: "粉";
                                        selected: root.accent-index == 1;
                                        clicked => {
                                            root.accent-selected(1);
                                        }
                                    }

                                    Dot {
                                        dot: root.dot2;
                                        name: "橙";
                                        selected: root.accent-index == 2;
                                        clicked => {
                                            root.accent-selected(2);
                                        }
                                    }

                                    Dot {
                                        dot: root.dot3;
                                        name: "紫";
                                        selected: root.accent-index == 3;
                                        clicked => {
                                            root.accent-selected(3);
                                        }
                                    }

                                    Dot {
                                        dot: root.dot4;
                                        name: "绿";
                                        selected: root.accent-index == 4;
                                        clicked => {
                                            root.accent-selected(4);
                                        }
                                    }
                                }
                            }
                        }

                        Hint {
                            text: "正在打字的程序要等这次输入结束、下次激活旁译，候选窗才会换成新的字号、排版、主题和配色。";
                        }
                    }

                    if root.page == 2: VerticalLayout {
                        spacing: 20px;
                        alignment: start;

                        PageHeader {
                            title: "翻译";
                            subtitle: "中文候选旁边显示俄语。";
                        }

                        Card {
                            title: "模式";

                            Row {
                                label: "翻译模式";
                                desc: "关闭、逐字翻译，或整句翻译";
                                divider: false;

                                Segmented {
                                    labels: ["关", "逐字", "整句"];
                                    current: root.trmode;
                                    selected(index) => {
                                        root.trmode-selected(index);
                                    }
                                }
                            }
                        }

                        Hint {
                            text: "Ctrl+, 会在关、逐字、整句之间循环。正在打字的程序要等输入法下次激活。";
                        }
                    }

                    if root.page == 3: VerticalLayout {
                        spacing: 20px;
                        alignment: start;

                        PageHeader {
                            title: "词库";
                            subtitle: "用自己习惯的拼音，调出想要的中文和俄语释义。";
                        }

                        Card {
                            title: "我的词条";

                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;

                                HorizontalLayout {
                                    spacing: 8px;
                                    ComboBox {
                                        accessible-label: "编辑类型";
                                        model: ["自定义词条", "覆盖已有词的俄语"];
                                        current-index <=> root.lex-kind;
                                        selected => { root.lex-kind-changed(); }
                                    }
                                    Button {
                                        text: "新增";
                                        clicked => { root.lex-clear(); }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit {
                                        text <=> root.lex-search;
                                        placeholder-text: "搜索中文、拼音或俄语";
                                        accessible-label: "搜索词条";
                                        edited => { root.lex-filter(); }
                                    }
                                    ComboBox {
                                        accessible-label: "按主题筛选";
                                        model: root.lex-themes;
                                        current-index <=> root.lex-theme-index;
                                        selected(value) => {
                                            root.lex-theme-filter = self.current-index > 0 ? value : "";
                                            root.lex-filter();
                                        }
                                    }
                                }
                                ComboBox {
                                    accessible-label: "选择词条";
                                    model: root.lex-labels;
                                    current-index <=> root.lex-index;
                                    enabled: root.lex-labels.length > 1;
                                    selected => { root.lex-select(self.current-index); }
                                }
                                if root.lex-labels.length <= 1: Hint {
                                    text: root.lex-search == "" ? "还没有词条，可在下方添加。" : "没有匹配的词条。";
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit {
                                        text <=> root.lex-head;
                                        placeholder-text: "中文词头";
                                        accessible-label: "中文词头";
                                    }
                                    LineEdit {
                                        text <=> root.lex-reading;
                                        placeholder-text: "触发拼音，例如 pengyou";
                                        accessible-label: "触发拼音";
                                        edited => { root.lex-reading-changed(); }
                                    }
                                }
                                LineEdit {
                                    text <=> root.lex-russian;
                                    placeholder-text: root.lex-kind == 0 ? "俄语释义（可选）" : "要替换成的俄语释义";
                                    accessible-label: "俄语释义";
                                }
                                if root.lex-crowded: Hint {
                                    text: "这个拼音已有较多精确候选。可提高权重，或为新词选一个更好记的触发拼音。";
                                }
                                LineEdit {
                                    text <=> root.lex-theme;
                                    placeholder-text: "主题（可选）";
                                    accessible-label: "词条主题";
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit {
                                    text <=> root.lex-extra;
                                    placeholder-text: root.lex-kind == 0 ? "权重（可选，100 可排在内置精确首选前）" : "备注（可选）";
                                    accessible-label: root.lex-kind == 0 ? "候选权重" : "备注";
                                    }
                                    if root.lex-kind == 0: Button {
                                        text: "最高权重";
                                        clicked => { root.lex-extra = "9999"; }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Button {
                                        text: root.lex-editing ? "保存修改" : "添加词条";
                                        primary: true;
                                        clicked => { root.lex-save(); }
                                    }
                                    if root.lex-editing: Button {
                                        text: "删除词条";
                                        clicked => { root.lex-delete(); }
                                    }
                                }
                            }
                        }

                        Card {
                            title: "批量管理";

                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Button {
                                        text: root.lex-bulk-open ? "收起多选" : "多选词条";
                                        clicked => { root.lex-bulk-open = !root.lex-bulk-open; }
                                    }
                                    Button {
                                        text: "撤销最近删除或导入";
                                        enabled: root.lex-can-undo;
                                        clicked => { root.lex-undo(); }
                                    }
                                }
                                if root.lex-bulk-open: ListView {
                                    height: 180px;
                                    for choice[index] in root.lex-choices: CheckBox {
                                        text: choice.label;
                                        checked: choice.checked;
                                        toggled => { root.lex-mark(index, self.checked); }
                                    }
                                }
                                if root.lex-bulk-open: Button {
                                    text: "删除已选 " + root.lex-selected-count + " 条";
                                    enabled: root.lex-selected-count > 0;
                                    clicked => { root.lex-delete-selected(); }
                                }
                            }
                        }

                        Card {
                            title: "词典导入";

                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    pack := ComboBox {
                                        accessible-label: "主题词典";
                                        model: ["出行俄语", "点餐俄语", "办公俄语"];
                                    }
                                    Button {
                                        text: "加入我的词条";
                                        clicked => { root.lex-add-pack(pack.current-index); }
                                    }
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 8px;
                                    Button {
                                        text: "导入 TSV 文件";
                                        clicked => { root.lex-import(); }
                                    }
                                    Button {
                                        text: "打开下载目录";
                                        clicked => { root.lex-catalog(); }
                                    }
                                }
                                Hint {
                                    text: "主题词典加入自定义词条。本地 TSV 使用打开文件时选中的词库类型。";
                                }
                                if root.lex-preview-open: VerticalLayout {
                                    spacing: 8px;
                                    ComboBox {
                                        accessible-label: "重复词条处理方式";
                                        model: ["跳过重复", "覆盖重复", "合并俄语释义"];
                                        current-index <=> root.lex-duplicate-policy;
                                        selected => { root.lex-preview(); }
                                    }
                                    if root.lex-metadata != "": Hint { text: root.lex-metadata; }
                                    Hint { text: root.lex-preview-summary; }
                                    if root.lex-issues != "": TextEdit {
                                        text: root.lex-issues;
                                        read-only: true;
                                        height: 116px;
                                        accessible-label: "跳过的行和原因";
                                    }
                                    HorizontalLayout {
                                        alignment: start;
                                        spacing: 8px;
                                        Button {
                                            text: "确认导入";
                                            primary: true;
                                            enabled: root.lex-can-import;
                                            clicked => { root.lex-confirm-import(); }
                                        }
                                        Button {
                                            text: "取消";
                                            clicked => { root.lex-cancel-import(); }
                                        }
                                    }
                                }
                            }
                        }

                        Card {
                            title: "词库备份";
                            Row {
                                label: "导出个人词库";
                                desc: "保存自定义词条和俄语释义覆盖";
                                divider: false;
                                Button {
                                    text: "一键导出备份";
                                    clicked => { root.lex-export(); }
                                }
                            }
                        }

                        Card {
                            title: "本机文件";

                            Row {
                                label: "自定义短语";
                                desc: "用缩写快速打出常用的话";

                                Button {
                                    text: "打开短语文件";
                                    horizontal-stretch: 0;
                                    clicked => {
                                        root.open-phrases();
                                    }
                                }
                            }

                            Row {
                                label: "用户词库";
                                desc: "补充输入法里没有的中文词";

                                Button {
                                    text: "打开用户词库";
                                    horizontal-stretch: 0;
                                    clicked => {
                                        root.open-user-dict();
                                    }
                                }
                            }

                            Row {
                                label: "用户释义";
                                desc: "改写或补充俄语释义";

                                Button {
                                    text: "打开用户释义";
                                    horizontal-stretch: 0;
                                    clicked => {
                                        root.open-user-gloss();
                                    }
                                }
                            }

                            Row {
                                label: "表情包";
                                desc: "表情包文件所在的文件夹";
                                divider: false;

                                Button {
                                    text: "打开表情包文件夹";
                                    horizontal-stretch: 0;
                                    clicked => {
                                        root.open-packs();
                                    }
                                }
                            }
                        }

                        Card {
                            title: "本机条数";

                            ValueRow {
                                label: "自定义短语";
                                value: root.stat-phrases;
                            }

                            ValueRow {
                                label: "用户词库";
                                value: root.stat-dict;
                            }

                            ValueRow {
                                label: "用户释义";
                                value: root.stat-gloss;
                            }

                            ValueRow {
                                label: "表情包";
                                value: root.stat-packs;
                            }

                            ValueRow {
                                label: "自学习";
                                value: root.stat-learned;
                                divider: false;
                            }
                        }

                        Hint {
                            text: "在输入法里重新输入完整拼音，查看保存后的候选。";
                        }
                    }

                    if root.page == 4: VerticalLayout {
                        spacing: 20px;
                        alignment: start;

                        PageHeader {
                            title: "账号与更新";
                            subtitle: "登录是可选的；更新由单独的更新程序负责。";
                        }

                        Card {
                            title: "账号";

                            Row {
                                label: "旁译账号";
                                desc: "邮箱验证码登录。不登录也能正常打字";
                                divider: false;

                                Button {
                                    text: "打开账号窗口";
                                    horizontal-stretch: 0;
                                    clicked => {
                                        root.open-account();
                                    }
                                }
                            }
                        }

                        Hint {
                            text: "打字、词库和表情包都不需要登录。输入法不上传按键、候选或词库。只有账号窗口在发送验证码、登录或退出时才会联网。没有配置登录服务时，那个窗口会写明登录不可用。";
                        }

                        Card {
                            title: "更新";

                            Row {
                                label: "检查更新";
                                desc: "现在就去看有没有新版本";

                                Button {
                                    text: "检查更新";
                                    horizontal-stretch: 0;
                                    clicked => {
                                        root.check-update();
                                    }
                                }
                            }

                            Row {
                                label: "自动检查";
                                desc: "登录 Windows 时检查，有新版再提醒你";
                                divider: false;

                                Toggle {
                                    checked <=> root.updater-on;
                                    toggled => {
                                        root.updater-toggled(root.updater-on);
                                    }
                                }
                            }
                        }

                        Hint {
                            text: "检查和开关都交给已经安装的更新程序，结果由它自己提示。这个窗口不联网。";
                        }
                    }

                    if root.page == 5: VerticalLayout {
                        spacing: 16px;
                        alignment: start;

                        // Mascots 自带固定宽度，直接放进竖排会把整页宽度也卡死，所以外面包一层横排。
                        HorizontalLayout {
                            alignment: start;

                            Mascots {
                                dark: root.mascot-dark;
                                side: 64px;
                            }
                        }

                        Text {
                            text: "旁译";
                            font-family: "Microsoft YaHei UI";
                            font-size: 28px;
                            font-weight: 600;
                            color: Palette.foreground;
                        }

                        Text {
                            text: "版本 " + root.version + "  ·  中文输入，俄语候选";
                            font-family: "Microsoft YaHei UI";
                            font-size: 13px;
                            color: Theme.muted;
                        }

                        Card {
                            title: "许可";

                            Rectangle {
                                min-height: 8px;
                            }

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                padding-bottom: 12px;

                                Hint {
                                    text: "旁译自己的代码按 MIT 许可发布。词典数据按 CC BY-SA 3.0 / 4.0 随输入法发布，不编进这个设置程序。界面用 Slint 绘制，下面这枚徽章是免版税协议要求的署名，不是广告。";
                                }
                            }

                            Rectangle {
                                height: 110px;
                                vertical-stretch: 0;

                                AboutSlint { }
                            }
                        }

                        Card {
                            title: "隐私";

                            HorizontalLayout {
                                padding: 16px;

                                Hint {
                                    text: "输入法本体离线运行，没有广告，也不做遥测。账号窗口和更新程序是另外两个程序。";
                                }
                            }
                        }
                    }
                }
            }

            if root.status != "": Rectangle {
                vertical-stretch: 0;
                height: 36px;
                background: Palette.alternate-background;

                Rectangle {
                    height: 1px;
                    y: 0;
                    background: Palette.border;
                }

                Text {
                    x: 32px;
                    width: parent.width - 64px;
                    text: root.status;
                    font-family: "Microsoft YaHei UI";
                    font-size: 12px;
                    overflow: elide;
                    vertical-alignment: center;
                    color: Palette.foreground;
                }
            }
        }
    }
}
